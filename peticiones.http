### Variables
@baseUrl = http://localhost:3000

### 1. Health Check (Pública)
GET {{baseUrl}}/health
Accept: application/json


### =================================================================
### AUTHENTICATION ENDPOINTS (Públicos)
### =================================================================

### 2. Registrar nuevo Usuario
# @name registerUser
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "profesor@school.edu",
  "password": "Password123!",
  "role": "teacher"
}

### 3. Iniciar Sesión (Obtener JWT Token)
# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "profesor@school.edu",
  "password": "Password123!"
}

### Guardar Token JWT obtenido del login
@token = {{loginUser.response.body.token}}

### 3b. Solicitar Recuperación de Contraseña
# @name forgotPassword
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "profesor@school.edu"
}

### 3c. Restablecer Contraseña con Token
# @name resetPassword
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "token": "{{forgotPassword.response.body.resetToken}}",
  "newPassword": "NewPassword123!"
}

### =================================================================
### PROFESORES ENDPOINTS (Protegidos con JWT)
### =================================================================

### 4. Crear un Profesor
# @name createProfesor
POST {{baseUrl}}/profesores
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Dr. Alan Turing",
  "email": "alan.turing@school.edu",
  "especialidad": "Computación y Lógica"
}

### Guardar ID del Profesor creado
@profesorId = {{createProfesor.response.body.profesor.id}}

### 5. Obtener todos los Profesores
GET {{baseUrl}}/profesores
Accept: application/json
Authorization: Bearer {{token}}

### 6. Obtener un Profesor por ID
GET {{baseUrl}}/profesores/{{profesorId}}
Accept: application/json
Authorization: Bearer {{token}}

### 7. Actualizar un Profesor
PUT {{baseUrl}}/profesores/{{profesorId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Dr. Alan M. Turing",
  "email": "alan.turing.updated@school.edu",
  "especialidad": "Ciencia de la Computación"
}


### =================================================================
### ALUMNOS ENDPOINTS (Protegidos con JWT)
### =================================================================

### 8. Crear un Alumno
# @name createAlumno
POST {{baseUrl}}/alumnos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Lucas Soto",
  "email": "lucassotovargas@gmail.com",
  "edad": 19
}

### Guardar ID del Alumno creado
@alumnoId = {{createAlumno.response.body.alumno.id}}

### 9. Obtener todos los Alumnos
GET {{baseUrl}}/alumnos
Accept: application/json
Authorization: Bearer {{token}}

### 10. Obtener un Alumno por ID
GET {{baseUrl}}/alumnos/{{alumnoId}}
Accept: application/json
Authorization: Bearer {{token}}

### 11. Actualizar un Alumno
PUT {{baseUrl}}/alumnos/{{alumnoId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Ada King Lovelace",
  "email": "ada.lovelace@school.edu",
  "edad": 20
}


### =================================================================
### MATERIAS ENDPOINTS (Protegidos con JWT)
### =================================================================

### 12. Crear una Materia (Asociada al Profesor creado)
# @name createMateria
POST {{baseUrl}}/materias
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Algoritmos y Estructuras de Datos",
  "profesor_id": "{{profesorId}}"
}

### Guardar ID de la Materia creada
@materiaId = {{createMateria.response.body.materia.id}}

### 13. Obtener todas las Materias
GET {{baseUrl}}/materias
Accept: application/json
Authorization: Bearer {{token}}

### 14. Obtener una Materia por ID
GET {{baseUrl}}/materias/{{materiaId}}
Accept: application/json
Authorization: Bearer {{token}}

### 15. Actualizar una Materia
PUT {{baseUrl}}/materias/{{materiaId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Algoritmos Avanzados",
  "profesor_id": "{{profesorId}}"
}


### =================================================================
### INSCRIPCIONES ENDPOINTS (Protegidos con JWT)
### =================================================================

### 16. Inscribir Alumno en Materia
# @name createInscripcion
POST {{baseUrl}}/inscripciones
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "alumno_id": "{{alumnoId}}",
  "materia_id": "{{materiaId}}"
}

### Guardar ID de la Inscripción creada
@inscripcionId = {{createInscripcion.response.body.inscripcion.id}}

### 17. Obtener todas las Inscripciones
GET {{baseUrl}}/inscripciones
Accept: application/json
Authorization: Bearer {{token}}

### 18. Obtener Inscripciones de un Alumno
GET {{baseUrl}}/inscripciones/alumno/{{alumnoId}}
Accept: application/json
Authorization: Bearer {{token}}

### 19. Obtener Inscripciones de una Materia
GET {{baseUrl}}/inscripciones/materia/{{materiaId}}
Accept: application/json
Authorization: Bearer {{token}}


### =================================================================
### CLEANUP (DELETE ENDPOINTS - Protegidos con JWT)
### =================================================================

### 20. Eliminar Inscripción por Relación Alumno-Materia
DELETE {{baseUrl}}/inscripciones/alumno/{{alumnoId}}/materia/{{materiaId}}
Accept: application/json
Authorization: Bearer {{token}}

### 21. Eliminar Materia
DELETE {{baseUrl}}/materias/{{materiaId}}
Accept: application/json
Authorization: Bearer {{token}}

### 22. Eliminar Profesor
DELETE {{baseUrl}}/profesores/{{profesorId}}
Accept: application/json
Authorization: Bearer {{token}}

### 23. Eliminar Alumno
DELETE {{baseUrl}}/alumnos/{{alumnoId}}
Accept: application/json
Authorization: Bearer {{token}}
